# Copy to .env and fill in. Never commit .env.
# LLM Provider: "gemini" (default) or "universal"
LLM_PROVIDER=gemini
GEMINI_ENABLED=true

# --- Gemini provider (primary + quota/unavailable fallback chain) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# --- Universal provider (OpenAI-compatible: Groq, OpenRouter, NVIDIA NIM, Kilo) ---
# Free-cloud failover example (Groq free tier):
#   UNIVERSAL_BASE_URL=https://api.groq.com/openai/v1
#   UNIVERSAL_MODEL=llama-3.3-70b-versatile (+ UNIVERSAL_API_KEY=<your key>)
UNIVERSAL_BASE_URL=
UNIVERSAL_API_KEY=
UNIVERSAL_MODEL=

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_WS_PORT=8765
BACKEND_HTTP_PORT=8766

# --- Plugins ---
GITHUB_TOKEN=

# --- Voice (free local Edge-TTS out + faster-whisper in; no keys) ---
VOICE_ENABLED=true
VOICE_ID=en-GB-RyanNeural
VOICE_RATE=+30%
VOICE_REPLY_MAX_CHARS=2000
STT_MODEL=small.en
